{
    "name": "yu-laravel/similar-words",
    "description": "Laravel Livewire tool that finds words and phrases with the closest embedding vector and shows them on a map.",
    "type": "library",
    "keywords": [
        "laravel",
        "livewire",
        "embeddings",
        "semantic-search",
        "ai"
    ],
    "homepage": "https://github.com/yuriyakishin/laravel-similar-words",
    "license": "MIT",
    "authors": [
        {
            "name": "Yuriy Akishin",
            "email": "yuriy.akishin@gmail.com",
            "homepage": "https://yu.net.ua"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-mbstring": "*",
        "laravel/framework": "^13.0",
        "livewire/livewire": "^4.0",
        "yu-laravel/web-tools-core": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "Yu\\SimilarWords\\": "src/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-main": "1.x-dev"
        },
        "laravel": {
            "providers": [
                "Yu\\SimilarWords\\SimilarWordsServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
